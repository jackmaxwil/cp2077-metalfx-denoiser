# MetalFX Denoiser Configuration
# Game: Cyberpunk 2077 macOS

[metalfx]
# Enable MetalFX denoising (set to false to use original NRD)
enabled = true

# Quality preset: "performance", "balanced", "quality"
quality = "quality"

# Sharpening amount (0.0 - 1.0)
sharpness = 0.5

[features]
# Enable/disable individual RT features
shadows = true
rtxdi_diffuse = true
rtxdi_specular = true
restir_gi = true
reflections = true
ao = true

[debug]
# Log performance metrics every N frames (0 = disabled)
log_performance = 0

# Show comparison view (NRD vs MetalFX side-by-side)
show_comparison = false

# Verbose logging
verbose = false
