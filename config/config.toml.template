# MetalFX Denoiser (Cyberpunk 2077 2.3.1, macOS 26 or later, Apple silicon)

[metalfx]
# Apple's MetalFX denoiser in place of the game's ray tracing denoiser (NRD) and MetalFX upscaler.
# Applies with ray traced lighting (Ultra, Psycho) or path tracing, with the game's upscaler set to MetalFX
# (Resolution Scaling). Path tracing: about as fast as NRD at the same preset, and clean enough at Performance.
# Also switchable in game: ModMenu (` or F10) > MetalFX Denoiser; ModMenu saves that choice and it wins over this one.
enabled = true

# Render at a third of the output resolution and let MetalFX upscale 3x (the engine's "Ultra Performance" scale, which
# the game's menu does not offer). With the denoiser, path tracing at 3456x2160 goes from about 50 to about 28 ms.
# Needs Resolution Scaling set to MetalFX. Also in ModMenu.
ultra_performance = false

# Sharper textures: added to the texture LOD bias of the game's samplers (negative = sharper mip levels). -0.585 matches
# the 3x upscale (the game's bias suits 2x); in general log2(2 / ultra_scale), so -0.32 for 2.5. Applies from the next
# game start; may add shimmer on fine detail.
texture_lod_bias = 0.0

# Sharpening after the Apple denoiser, 0 (off) to 1 (strongest): contrast adaptive (AMD's RCAS), against the softness
# of the 3x upscale. The game's own sharpening setting does not apply with the denoiser. Also in ModMenu.
# With path tracing it also sharpens the denoiser's leftover noise: 0.4 measured 2 dB more still-image flicker than 0.
sharpness = 0.0

# Render scale of ultra_performance: 3.0 (the engine's hidden "Ultra Performance") down to 2.0. 2.5 renders 1382x864 for
# 3456x2160: fewer jagged edges and more texture detail than 3.0, for more GPU time per frame (path tracing at
# 3456x2160: about 28 ms at 3.0, 32 ms at 2.75, 38 ms at 2.5). Also in ModMenu.
ultra_scale = 3.0

# Frame generation: MetalFX generates one frame between every two the game renders (about 3 ms each at 3456x2160), so
# the display shows about twice the frames; responsiveness stays at the rendered rate. Also in ModMenu.
frame_generation = false
# With frame_generation_multiplier = 4: turn each shown frame to the mouse input of about a frame later (camera turns
# show up a frame sooner). Rotation only; the HUD stays put; screen edges may smear slightly during fast turns.
camera_warp = false
# Frame rate cap that waits right before the game reads input (fresher input than the game's own Maximum FPS, which
# should then be off). 0 = off. For 120 Hz with frame_generation_multiplier = 4: 29 (four refreshes fit with slack).
frame_limit_fps = 0
# With frame_limit_fps: start each frame (and read input) only when its CPU part will end about when the GPU frees up,
# so input does not wait behind queued GPU work (like NVIDIA Reflex). In game with 4x: mouse read to frame rendered
# 75 -> 60 ms median, same frame rate; 2x: 48 -> 45 ms.
low_latency = true
# Path tracing: drop the game's per-frame zero fills of 8 MiB and more in its path tracing setup (about 330 of 550 MiB
# per frame, 1.5 ms of GPU; same image in tests, 6-minute soak clean). Only for game 2.3.1 (checked by binary UUID).
skip_rt_clears = false
# With ultra_performance: hold this rendered frame rate by stepping the render scale between ultra_scale (sharpest) and
# 3.0. With the game's dynamic resolution on (UserSettings.json, /graphics/presets: DynamicResolutionScaling = true;
# not in the menu) a change costs nothing (MetalFX keeps one scaler and its history) and steps come every 2 s at most.
# Without it each change reallocates the render targets (path tracing: about 160 ms), at most every 10 s.
# 0 = off (always ultra_scale).
dynamic_scale_fps = 0
# Displayed frames per rendered frame with frame generation: 2 (one generated frame), or 4 (three, generated at half
# size: about the same GPU cost as 2, softer in-between frames, the real frame shown a little later). For 120 Hz with
# 4, cap the game at 30 fps (Video settings, Maximum FPS) and pick an ultra_scale that renders in under 33 ms.
frame_generation_multiplier = 2

[debug]
# Input lag timeline: 300 frames every N frames (0 = off) as trace/timeline-<n>.jsonl, summarized in the log ("Timeline:");
# scripts/timeline_report.py splits it into mouse, CPU, GPU queue, GPU and display.
log_timeline = 1800

# Show the noisy lighting (NRD off, no denoiser): for comparisons only.
noisy_lighting = false

# Frame time log: a 120-frame timing window every N frames (0 = off), one "Perf play-..." line each in the game's
# output (frame time, fps, GPU busy time, and whether the GPU or the CPU limits the frame rate).
log_performance = 600

# Metal tracer for research (pipeline names, frame traces, timings); METALFX_TRACE=1 does the same.
trace_metal_compute = false
