# MetalFX Denoiser (Cyberpunk 2077 2.3.1, macOS 26 or later, Apple silicon)

[metalfx]
# Apple's MetalFX denoiser in place of the game's ray tracing denoiser (NRD) and MetalFX upscaler.
# Applies with ray traced lighting (Ultra, Psycho) or path tracing, with the game's upscaler set to MetalFX
# (Resolution Scaling). Path tracing: about as fast as NRD at the same preset, and clean enough at Performance.
# Also switchable in game: ModMenu (` or F10) > MetalFX Denoiser; ModMenu saves that choice and it wins over this one.
enabled = true

# Render at a third of the output resolution and let MetalFX upscale 3x (the engine's "Ultra Performance" scale, which
# the game's menu does not offer). With the denoiser, path tracing at 3456x2160 goes from about 50 to about 28 ms.
# Needs Resolution Scaling set to MetalFX. Also in ModMenu.
ultra_performance = false

[debug]
# Show the noisy lighting (NRD off, no denoiser): for comparisons only.
noisy_lighting = false

# Frame time log: a 120-frame timing window every N frames (0 = off), one "Perf play-..." line each in the game's
# output (frame time, fps, GPU busy time, and whether the GPU or the CPU limits the frame rate).
log_performance = 600

# Metal tracer for research (pipeline names, frame traces, timings); METALFX_TRACE=1 does the same.
trace_metal_compute = false
